---
// Field-guide tab and card (D-56, docs/guide-leads.md). A one-line tab in the bottom-left corner
// opens a compact card with the lead form; it is not a modal (no overlay, focus steal or scroll
// lock). Rendered by Base only while the guide is enabled (data/guide.ts). Behavior: scripts/guide.ts.
import { guide } from '../data/guide';
import { GUIDE_ENDPOINT, showPrivacy } from '../lib/site';

// Decided at build time, so the 404 page stays quiet at whatever URL the host serves it from.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const quiet = (guide.quietPaths as readonly string[]).includes(path);
---
<aside
  class="guide"
  id="guide-prompt"
  aria-labelledby="gd-title"
  data-guide-prompt
  data-state="tab"
  data-quiet={quiet ? '' : undefined}
  data-endpoint={GUIDE_ENDPOINT}
  data-guide={guide.id}
  data-file={guide.file}
  data-file-name={guide.downloadName}
  hidden
>
  <canvas class="gd-glass" aria-hidden="true"></canvas>
  <button type="button" class="gd-x" data-guide-close aria-label="Hide the field guide offer">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <div class="gd-inner">
    <button type="button" class="gd-tab" data-guide-expand aria-expanded="false" aria-controls="gd-body">
      <svg class="gd-doc" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg>
      <span>{guide.kicker}</span>
      <svg class="gd-go" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>

    <div class="gd-body" id="gd-body" hidden>
      <p class="gd-kicker">{guide.kicker}</p>
      <h2 class="gd-title" id="gd-title"><a href={guide.post}>{guide.title}</a></h2>
      <div class="gd-pitch">
        <p class="gd-promise">{guide.promise}</p>
        <ul class="gd-facts" aria-label="In the guide">{guide.facts.map((f) => <li>{f}</li>)}</ul>
      </div>

      <form class="gd-form" novalidate data-guide-form>
        <div class="field"><label for="gd-name">Name</label><input id="gd-name" name="name" autocomplete="name" maxlength="120" required aria-describedby="gd-err" /></div>
        <div class="field"><label for="gd-email">Work email</label><input id="gd-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required aria-describedby="gd-err" /></div>
        <div class="hp" aria-hidden="true"><label for="gd-website">Leave this field empty</label><input id="gd-website" name="website" tabindex="-1" autocomplete="off" /></div>
        <p class="gd-err" id="gd-err" role="alert" hidden></p>
        <button class="btn btn-primary gd-submit" type="submit"><span>{guide.button}</span></button>
        <p class="gd-notice">The guide downloads right away. We may email you to follow up about it. See our {showPrivacy ? <a href="/privacy-policy">Privacy Policy</a> : 'Privacy Policy'}.</p>
      </form>

      <div class="gd-done" data-guide-done role="status" tabindex="-1" hidden>
        <p class="gd-done-title">Your guide is downloading.</p>
        <p>Look for it in your downloads. If it did not start, <a href={guide.file} download={guide.downloadName}>download the PDF here</a>.</p>
      </div>
    </div>
  </div>
</aside>

<script>
  import '../scripts/guide.ts';
</script>

<style>
  .guide {
    --gd-left: max(16px, env(safe-area-inset-left, 0px));
    --gd-right: max(16px, env(safe-area-inset-right, 0px));
    --gd-bottom: max(16px, env(safe-area-inset-bottom, 0px));
    position: fixed;
    left: var(--gd-left);
    bottom: var(--gd-bottom);
    /* Above the page, below the sticky header (60), reading progress (70) and skip link. */
    z-index: 58;
    display: flex;
    width: min(350px, calc(100vw - var(--gd-left) - var(--gd-right)));
    /* Never reaches the header: the content scrolls inside the card instead. */
    max-height: calc(100dvh - var(--header-h) - 2 * var(--gd-bottom));
    overflow: hidden;
    border-radius: var(--radius-lg);
    color: var(--ink);
    font-family: var(--f-body);
    /* Opaque enough that --muted text keeps AA even over the navy footer. */
    background: linear-gradient(180deg, rgba(255, 255, 255, .94), rgba(255, 255, 255, .88));
    -webkit-backdrop-filter: blur(18px) saturate(170%);
    backdrop-filter: blur(18px) saturate(170%);
    border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgba(11, 26, 47, .05), 0 18px 40px -22px rgba(11, 26, 47, .38);
    opacity: 0;
    translate: 0 8px;
    transition: opacity 240ms var(--ease-out), translate 320ms var(--ease-out);
  }
  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .guide { background: var(--mist); }
  }
  .guide[hidden] { display: none; }
  .guide.is-in { opacity: 1; translate: 0 0; }

  /* WebGL liquid glass (vendor/liquid-glass.js), drawn only on the open card once the engine has
     bound it (data-lg="glass"). Without WebGL2 the CSS glass above stays. */
  .gd-glass { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; display: none; border-radius: inherit; pointer-events: none; }
  .guide[data-lg='glass']:not([data-state='tab']) { background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; border-color: transparent; }
  .guide[data-lg='glass']:not([data-state='tab']) .gd-glass { display: block; }

  .gd-inner { flex: 1; min-width: 0; overflow: hidden auto; overscroll-behavior: contain; padding: 22px 22px 20px; }

  .gd-x { position: absolute; top: 8px; right: 8px; z-index: 1; display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--muted); cursor: pointer; transition: background-color var(--t-hover), color var(--t-hover); }
  .gd-x::before { content: ''; position: absolute; inset: -6px; }
  .gd-x:hover { background: var(--wash); color: var(--ink); }

  /* At rest: one line, the tab. */
  .guide[data-state='tab'] { width: auto; border-radius: 999px; }
  .guide[data-state='tab'] .gd-inner { padding: 0 40px 0 0; overflow: visible; }
  .guide[data-state='tab'] .gd-x { top: 50%; right: 6px; translate: 0 -50%; }
  .gd-tab { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 0 6px 0 16px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font: 600 14px/1 var(--f-body); cursor: pointer; transition: color var(--t-hover); }
  .gd-tab:hover { color: var(--blue); }
  .gd-doc { color: var(--blue); flex: none; }
  .gd-go { flex: none; transition: transform var(--t-hover) var(--ease-out); }
  .gd-tab:hover .gd-go { transform: translateX(3px); }
  .guide:not([data-state='tab']) .gd-tab { display: none; }

  :is(.gd-x, .gd-tab):focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }

  .gd-body[hidden] { display: none; }
  .gd-kicker { padding-right: 32px; font: 600 12px/1.4 var(--f-body); letter-spacing: .16em; text-transform: uppercase; color: var(--blue); }
  .gd-title { margin-top: 6px; font: var(--display-weight) 25px/1.15 var(--f-display); letter-spacing: var(--display-track); }
  .gd-title a { color: var(--ink); text-decoration: none; }
  .gd-title a:hover { color: var(--blue); text-decoration: underline; text-decoration-thickness: 1px; }
  .gd-title a:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; border-radius: var(--radius-sm); }
  .gd-promise { margin-top: 10px; font-size: 15px; line-height: 1.55; color: var(--muted); }
  .gd-facts { list-style: none; margin: 14px 0 18px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .gd-facts li { padding: 5px 10px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255, 255, 255, .72); font: 500 12.5px/1.3 var(--f-body); color: var(--ink); }

  .gd-form { display: grid; gap: 12px; }
  .gd-form[hidden] { display: none; }
  .gd-form .field label { font-size: 13.5px; }
  .gd-form .field input { min-height: 46px; padding-block: 10px; }
  .gd-err { font-size: 13.5px; font-weight: 500; color: var(--danger); }
  .gd-err[hidden] { display: none; }
  .gd-submit { justify-self: start; min-height: 48px; padding-inline: 22px; }
  .gd-notice { font-size: 12.5px; line-height: 1.5; color: var(--muted); }

  .gd-done { display: grid; gap: 6px; margin-top: 4px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(255, 255, 255, .78); font-size: 14.5px; line-height: 1.5; color: var(--muted); }
  .gd-done[hidden] { display: none; }
  .gd-done:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .gd-done-title { font-weight: 600; color: var(--ink); }
  .guide[data-state='done'] .gd-pitch { display: none; }

  .guide:not([data-state='tab']) .gd-body, .gd-done:not([hidden]) { animation: gd-in 280ms var(--ease-out) both; }
  @keyframes gd-in { from { opacity: 0; translate: 0 8px; } }

  /* Phones: the open card spans the width, still clear of the bottom edge. */
  @media (max-width: 560px) {
    .guide:not([data-state='tab']) { width: calc(100vw - var(--gd-left) - var(--gd-right)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .guide { translate: none; transition: opacity 200ms linear; }
    .guide:not([data-state='tab']) .gd-body, .gd-done:not([hidden]) { animation-name: gd-fade; }
    .gd-go { transition: none; }
  }
  @keyframes gd-fade { from { opacity: 0; } }
  @media print { .guide { display: none !important; } }
</style>
